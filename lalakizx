local function New(class, props, children)
	local o = Instance.new(class)
	for k,v in pairs(props) do o[k]=v end
	for _,c in ipairs(children or {}) do c.Parent=o end
	return o
end
local function Corner(r) return New("UICorner",{CornerRadius=UDim.new(0,r)}) end
local function Stroke(c,t) return New("UIStroke",{Color=c,Thickness=t or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border}) end
local function Tween(o,t,p,s)
	TweenService:Create(o,TweenInfo.new(t,s or Enum.EasingStyle.Quint,Enum.EasingDirection.Out),p):Play()
end

-- Universal draggable
local function MakeDraggable(frame, handle)
	local drag, ds, sp = false, nil, nil
	handle.InputBegan:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		drag=true; ds=i.Position; sp=frame.Position
		i.Changed:Connect(function()
			if i.UserInputState==Enum.UserInputState.End then drag=false end
		end)
	end)
	UserInputService.InputChanged:Connect(function(i)
		if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
			local d=i.Position-ds
			frame.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
		end
	end)
end

-- Slider factory — returns setter function
local function MakeSlider(parent, yPos, labelText, minV, maxV, defaultV, onChange)
	New("TextLabel",{
		Text=labelText, Font=Enum.Font.GothamMedium, TextSize=13,
		TextColor3=THEME.Text, BackgroundTransparency=1,
		Position=UDim2.fromOffset(16,yPos), Size=UDim2.new(0.65,0,0,18),
		TextXAlignment=Enum.TextXAlignment.Left,
	}).Parent=parent

	local valLbl=New("TextLabel",{
		Text=tostring(defaultV), Font=Enum.Font.GothamMedium, TextSize=13,
		TextColor3=THEME.Text, BackgroundTransparency=1,
		AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,-16,0,yPos),
		Size=UDim2.fromOffset(70,18), TextXAlignment=Enum.TextXAlignment.Right,
	})
	valLbl.Parent=parent

	local track=New("Frame",{
		Position=UDim2.fromOffset(16,yPos+22), Size=UDim2.new(1,-32,0,7),
		BackgroundColor3=THEME.Off,
	},{Corner(3)})
	track.Parent=parent

	local ratio0=math.clamp((defaultV-minV)/(maxV-minV),0,1)
	local fill=New("Frame",{Size=UDim2.fromScale(ratio0,1),BackgroundColor3=THEME.On},{Corner(3)})
	fill.Parent=track

	local dragging=false
	local function setRatio(r)
		r=math.clamp(r,0,1)
		local v=math.floor(minV+r*(maxV-minV))
		valLbl.Text=tostring(v)
		fill.Size=UDim2.fromScale(r,1)
		onChange(v)
	end

	track.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then
			dragging=true
			setRatio((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
			setRatio((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X)
		end
	end)
end

