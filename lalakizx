local espObjs={}
local function GetESP(p)
	if not espObjs[p] then
		local e={
			box    = Drawing.new("Square"),
			name   = Drawing.new("Text"),
			hp     = Drawing.new("Text"),
			tracer = Drawing.new("Line"),
		}
		e.box.Filled=false; e.box.Color=Color3.fromRGB(255,60,60); e.box.Thickness=1.5
		e.name.Size=13; e.name.Color=Color3.fromRGB(255,255,255); e.name.Outline=true; e.name.Center=true
		e.hp.Size=11;   e.hp.Color=Color3.fromRGB(100,255,100);   e.hp.Outline=true;   e.hp.Center=true
		e.tracer.Thickness=1; e.tracer.Color=Color3.fromRGB(255,60,60)
		espObjs[p]=e
	end
	return espObjs[p]
end
Players.PlayerRemoving:Connect(function(p)
	if espObjs[p] then for _,d in pairs(espObjs[p]) do d:Remove() end; espObjs[p]=nil end
end)
RunService.RenderStepped:Connect(function()
	for _,p in ipairs(Players:GetPlayers()) do
		if p==player then continue end
		local e=GetESP(p)
		local char=p.Character
		local hum =char and char:FindFirstChildOfClass("Humanoid")
		local root=char and char:FindFirstChild("HumanoidRootPart")
		local head=char and char:FindFirstChild("Head")
		local hide=not Settings:Get("ESP") or not char or not hum or not root
			or not head or hum.Health<=0
			or (Settings:Get("TeamCheck") and p.Team==player.Team and p.Team~=nil)
		if hide then for _,d in pairs(e) do d.Visible=false end; continue end

		local hScr,hOn=camera:WorldToViewportPoint(head.Position+Vector3.new(0,1.5,0))
		local fScr    =camera:WorldToViewportPoint(root.Position-Vector3.new(0,3,0))
		if not hOn then for _,d in pairs(e) do d.Visible=false end; continue end

		local vis=HasLOS(camera.CFrame.Position,root.Position)
		local col=vis and Color3.fromRGB(255,60,60) or Color3.fromRGB(255,165,0)
		local bH=math.abs(hScr.Y-fScr.Y)
		local bW=bH*0.55

		e.box.Visible=true; e.box.Size=Vector2.new(bW,bH)
		e.box.Position=Vector2.new(hScr.X-bW/2,hScr.Y); e.box.Color=col
		e.name.Visible=true; e.name.Text=p.DisplayName
		e.name.Position=Vector2.new(hScr.X,hScr.Y-17)
		e.hp.Visible=true; e.hp.Text=math.floor(hum.Health).." HP"
		e.hp.Position=Vector2.new(hScr.X,fScr.Y+2)
		e.tracer.Visible=true
		e.tracer.From=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y)
		e.tracer.To=Vector2.new(hScr.X,hScr.Y); e.tracer.Color=col
	end
end)

